          target="_blank"
          rel="noopener noreferrer"
          class="border-2 border-black px-3 py-1.5 text-[10px] font-bold tracking-widest uppercase hover:bg-black hover:text-[#F4EBD9] transition-colors shadow-[2px_2px_0px_0px_#000] hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px]"
        >
          {s.label}
        </a>
      ))}
    </div>
  </div>

  <!-- ============================================ -->
  <!-- COPYRIGHT BAR                                -->
  <!-- ============================================ -->
  <div class="flex flex-col sm:flex-row justify-between items-center text-[10px] font-bold tracking-widest uppercase text-[#1A1A1A]/40 pt-4 border-t border-black/20">
    <p>&copy; 2026 VAISHNAVI GUPTA</p>
    <p>BUILT WITH ASTRO + TAILWIND</p>
  </div>

</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('[data-project-tab]');
    const cards = document.querySelectorAll('[data-project-card]');
    const metrics = document.querySelectorAll('[data-project-metrics]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const id = tab.getAttribute('data-project-tab');

        // Update tab styles
        tabs.forEach((t) => {
          t.className = t.className
            .replace('bg-[#FF7597]', 'bg-[#EFEAD8]')
            .replace('shadow-[2px_2px_0px_0px_#000]', '')
            .replace('text-[#1A1A1A]', 'text-[#1A1A1A]/70');
        });
        tab.className = tab.className
          .replace('bg-[#EFEAD8]', 'bg-[#FF7597]')
          .replace('text-[#1A1A1A]/70', 'text-[#1A1A1A]');
        if (!tab.className.includes('shadow-[2px_2px_0px_0px_#000]')) {
          tab.classList.add('shadow-[2px_2px_0px_0px_#000]');
        }

        // Show matching card and metrics, hide others
        cards.forEach((c) => {
          c.classList.toggle('hidden', c.getAttribute('data-project-card') !== id);
        });
        metrics.forEach((m) => {
          m.classList.toggle('hidden', m.getAttribute('data-project-metrics') !== id);
        });
      });
    });

    // Certificate folder toggles
    const certData = [
      { title: "UiPath Academy Automation Developer Associate Training - UiPath (2026)", filename: "UIPATH.TXT", link: "#" },
      { title: "Data Science Placement Course - Internshala (2024)", filename: "DATASCIENCE.TXT", link: "#" },
      { title: "Data Analysis Using Python - IBM (2024)", filename: "DATAANALYSIS.TXT", link: "#" },
      { title: "Programming with Python - Samsung Innovation Campus (2024)", filename: "SAMSUNG_PYTHON.TXT", link: "#" },
      { title: "Artificial Intelligence - Samsung Innovation Campus (2023)", filename: "SAMSUNG_AI.TXT", link: "#" },
    ];

    const folders = document.querySelectorAll('.certificate-folder');
    const detail = document.getElementById('certificate-detail');
    const certTitle = document.getElementById('cert-title');
    const certFilename = document.getElementById('cert-filename');
    const certLink = document.getElementById('cert-link');

    folders.forEach((folder) => {
      folder.addEventListener('click', () => {
        const idx = parseInt(folder.getAttribute('data-cert-index'));
        const data = certData[idx];
        certTitle.textContent = data.title;
        certFilename.textContent = data.filename;
        certLink.href = data.link;
        detail.classList.remove('hidden');
      });
    });

    document.getElementById('cert-close').addEventListener('click', () => {
      detail.classList.add('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!detail.classList.contains('hidden') && !detail.contains(e.target) && !e.target.closest('.certificate-folder')) {
        detail.classList.add('hidden');
      }
    });
  });
</script>
