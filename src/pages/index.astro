---
import Layout from '../layouts/Layout.astro';

const columnOne = [
  { name: "Apps & Software", url: "#", tag: "SYS" },
  { name: "Hardware Projects", url: "#", tag: "HW" },
  { name: "AI Tools & GPTs", url: "#", tag: "AI" },
  { name: "Python Scripts", url: "#", tag: "CODE" }
];

const columnTwo = [
  { name: "Build Logs & Notes", url: "#", tag: "LOG" },
  { name: "System Architecture", url: "#", tag: "DOC" },
  { name: "Indigenous Literatures", url: "#", tag: "M.A." },
  { name: "Contact System", url: "#", tag: "NET" }
];

const columnThree = [
  { name: "Home Terminal", url: "#", tag: "ROOT" },
  { name: "Project Timeline", url: "#", tag: "TIME" },
  { name: "Literary Drawings", url: "#", tag: "ART" },
  { name: "Now Dashboard", url: "#", tag: "CUR" }
];

const columnFour = [
  { name: "Interactive Todo List", url: "#", tag: "TOOL" },
  { name: "Memory Card Game", url: "#", tag: "GAME" },
  { name: "Debate & AI Ethics", url: "#", tag: "WIN" },
  { name: "Tech News Feed", url: "#", tag: "RSS" }
];

const socialLinks = [
  { label: "LINKEDIN", url: "https://www.linkedin.com" },
  { label: "GITHUB", url: "https://github.com/vaishnxvii" },
  { label: "X / TWITTER", url: "#" },
  { label: "YOUTUBE", url: "#" },
  { label: "SUBSTACK", url: "#" }
];
---

<Layout title="VAISHNAVI GUPTA // TECH WIZ & AUTHOR">

  <!-- TOP UTILITY HUD -->
  <header class="border-2 border-[#1C1B1A] bg-[#F4EBD9]/80 backdrop-blur-md p-4 mb-8 shadow-[4px_4px_0px_0px_#1C1B1A] relative z-10 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="flex items-center space-x-3">
      <span class="relative flex h-3 w-3">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#22C55E] opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-[#22C55E] border-2 border-[#1C1B1A]"></span>
      </span>
      <h1 class="text-lg font-black tracking-[0.2em] text-[#1C1B1A]">~/VGUPTA</h1>
    </div>
    
    <div class="hidden md:flex items-center space-x-4 text-[10px] tracking-[0.2em] font-bold text-[#1C1B1A] uppercase">
      <span class="bg-[#1C1B1A]/10 px-3 py-1.5 border-2 border-[#1C1B1A] shadow-[2px_2px_0px_0px_#1C1B1A]">LOC: LUCKNOW, IN</span>
      <span class="text-[#06B6D4]">●</span>
      <span class="bg-[#22C55E] px-3 py-1.5 border-2 border-[#1C1B1A] text-[#1C1B1A] shadow-[2px_2px_0px_0px_#1C1B1A]">STATUS: ONLINE</span>
      <span class="text-[#FF7597]">●</span>
      <span class="bg-[#FF7597] px-3 py-1.5 border-2 border-[#1C1B1A] text-[#1C1B1A] shadow-[2px_2px_0px_0px_#1C1B1A]">{new Date().toLocaleTimeString()}</span>
    </div>

    <div class="flex items-center space-x-4">
      <a href="#" class="hover:text-[#06B6D4] transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0012 2z"></path></svg>
      </a>
      <button class="md:hidden border-2 border-[#1C1B1A] p-1 hover:bg-[#1C1B1A] hover:text-[#F4EBD9] transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
    </div>
  </header>

  <!-- HERO BANNER BOX -->
  <section class="border-2 border-[#1C1B1A] bg-[#121215] p-8 md:p-12 mb-8 shadow-[8px_8px_0px_0px_#1C1B1A] relative overflow-hidden group">
    <!-- Background Effects -->
    <div class="absolute inset-0 bg-grid-pattern opacity-20 mix-blend-screen"></div>
    <div class="absolute inset-0 bg-scanlines-dark opacity-30"></div>
    
    <!-- Side tabs mimicking hardware/punch cards -->
    <div class="absolute left-0 top-4 bottom-4 w-3 border-r-2 border-[#1C1B1A] bg-[#F4EBD9]/10 flex flex-col justify-evenly items-center py-4">
      <div class="w-2 h-2 rounded-full bg-[#FF7597] shadow-[1px_1px_0px_0px_#1C1B1A]"></div>
      <div class="w-2 h-2 rounded-full bg-[#06B6D4] shadow-[1px_1px_0px_0px_#1C1B1A]"></div>
      <div class="w-2 h-2 rounded-full bg-[#22C55E] shadow-[1px_1px_0px_0px_#1C1B1A]"></div>
    </div>
    
    <div class="pl-6 relative z-10">
      <div class="text-[10px] text-[#06B6D4] font-bold tracking-[0.3em] mb-4 uppercase flex items-center bg-[#121215]/80 inline-block px-3 py-1 border border-[#06B6D4]/30">
        <span class="mr-2 text-[#22C55E] animate-pulse">▶</span> ~/DIGITAL-GARDEN $ WHOAMI
      </div>
      
      <h2 class="text-4xl md:text-6xl font-black text-[#F4EBD9] tracking-tighter mb-4 uppercase">
        VAISHNAVI <br class="md:hidden"/> GUPTA
      </h2>
      
      <p class="text-sm md:text-base text-[#F4EBD9]/70 max-w-2xl leading-relaxed mb-6">
        M.A. ENGLISH <span class="text-[#FF7597] mx-1">|</span> PYTHON DEVELOPER <span class="text-[#06B6D4] mx-1">|</span> PUBLISHED AUTHOR
      </p>
      
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="#projects" class="inline-flex items-center px-6 py-3 border-2 border-[#F4EBD9] text-[#F4EBD9] text-xs font-black uppercase tracking-[0.2em] hover:bg-[#F4EBD9] hover:text-[#121215] transition-all duration-200 shadow-[4px_4px_0px_0px_rgba(244,235,217,0.5)] hover:shadow-none hover:translate-x-[4px] hover:translate-y-[4px]">
          VIEW PROJECTS <span class="ml-2">→</span>
        </a>
        <a href="#contact" class="inline-flex items-center px-6 py-3 bg-[#FF7597] border-2 border-[#1C1B1A] text-[#1C1B1A] text-xs font-black uppercase tracking-[0.2em] hover:bg-[#1C1B1A] hover:text-[#FF7597] transition-all duration-200 shadow-[4px_4px_0px_0px_#1C1B1A] hover:shadow-none hover:translate-x-[4px] hover:translate-y-[4px]">
          INIT CONNECTION <span class="ml-2">●</span>
        </a>
      </div>
    </div>
  </section>

  <!-- HIGHLIGHTED FEATURE BANNER (RETRO-FUTURISM CARDS) -->
  <section class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
    <div class="border-2 border-[#1C1B1A] bg-[#F4EBD9] p-5 hover:border-[#06B6D4] hover:translate-x-1 hover:-translate-y-1 transition-all duration-200 shadow-[4px_4px_0px_0px_#1C1B1A] group cursor-pointer relative overflow-hidden">
      <div class="absolute inset-0 bg-scanlines opacity-10 group-hover:opacity-20 transition-opacity"></div>
      <div class="absolute inset-0 bg-grid-pattern opacity-20"></div>
      <div class="text-[10px] text-[#FF7597] font-bold tracking-[0.2em] mb-2 relative z-10 uppercase bg-[#121215] inline-block px-2 py-0.5 border border-[#1C1B1A] shadow-[1px_1px_0px_0px_#1C1B1A]">Featured Work</div>
      <h3 class="text-sm font-bold text-[#1C1B1A] group-hover:text-[#06B6D4] transition-colors relative z-10 uppercase tracking-wide">After Life: Reborn of Love</h3>
      <p class="text-[11px] text-[#1C1B1A]/60 mt-2 relative z-10 font-mono leading-relaxed">Published romantic fiction exploring deep existential emotional frameworks.</p>
      <div class="absolute bottom-0 right-0 p-2 text-[10px] font-bold text-[#1C1B1A]/30">SYS.READ</div>
    </div>
    
    <div class="border-2 border-[#1C1B1A] bg-[#F4EBD9] p-5 hover:border-[#FF7597] hover:translate-x-1 hover:-translate-y-1 transition-all duration-200 shadow-[4px_4px_0px_0px_#1C1B1A] group cursor-pointer relative overflow-hidden">
      <div class="absolute inset-0 bg-scanlines opacity-10 group-hover:opacity-20 transition-opacity"></div>
      <div class="absolute inset-0 bg-grid-pattern opacity-20"></div>
      <div class="text-[10px] text-[#06B6D4] font-bold tracking-[0.2em] mb-2 relative z-10 uppercase bg-[#121215] inline-block px-2 py-0.5 border border-[#1C1B1A] shadow-[1px_1px_0px_0px_#1C1B1A]">Academic</div>
      <h3 class="text-sm font-bold text-[#1C1B1A] group-hover:text-[#FF7597] transition-colors relative z-10 uppercase tracking-wide">Indigenous Epistemologies</h3>
      <p class="text-[11px] text-[#1C1B1A]/60 mt-2 relative z-10 font-mono leading-relaxed">Dissertation analyzing traditional perspectives in Chinua Achebe's works.</p>
      <div class="absolute bottom-0 right-0 p-2 text-[10px] font-bold text-[#1C1B1A]/30">DOC.PHD</div>
    </div>
    
    <div class="border-2 border-[#1C1B1A] bg-[#F4EBD9] p-5 hover:border-[#22C55E] hover:translate-x-1 hover:-translate-y-1 transition-all duration-200 shadow-[4px_4px_0px_0px_#1C1B1A] group cursor-pointer relative overflow-hidden">
      <div class="absolute inset-0 bg-scanlines opacity-10 group-hover:opacity-20 transition-opacity"></div>
      <div class="absolute inset-0 bg-grid-pattern opacity-20"></div>
      <div class="text-[10px] text-[#22C55E] font-bold tracking-[0.2em] mb-2 relative z-10 uppercase bg-[#121215] inline-block px-2 py-0.5 border border-[#1C1B1A] shadow-[1px_1px_0px_0px_#1C1B1A]">Dev Log</div>
      <h3 class="text-sm font-bold text-[#1C1B1A] group-hover:text-[#22C55E] transition-colors relative z-10 uppercase tracking-wide">Python & Dashboard Audit</h3>
      <p class="text-[11px] text-[#1C1B1A]/60 mt-2 relative z-10 font-mono leading-relaxed">Rigorous functional testing, automation tools, and UI interface alignment maps.</p>
      <div class="absolute bottom-0 right-0 p-2 text-[10px] font-bold text-[#1C1B1A]/30">DEV.LOG</div>
    </div>
  </section>

  <!-- MAIN MULTI-COLUMN BENTO GRID -->
  <footer id="projects" class="border-2 border-[#1C1B1A] bg-[#121215] p-6 md:p-8 mb-8 shadow-[8px_8px_0px_0px_#1C1B1A] text-[#F4EBD9] relative overflow-hidden">
    <div class="absolute inset-0 bg-scanlines-dark opacity-20"></div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-8 relative z-10">
      
      <!-- COLUMN 1: PROJECTS -->
      <div>
        <div class="flex items-center space-x-2 text-[10px] font-bold tracking-[0.2em] text-[#FF7597] mb-4 uppercase border-b-2 border-[#1C1B1A] pb-2">
          <span class="text-[#FF7597]">●</span>
          <span>SYS.DIR // PROJECTS</span>
        </div>
        <ul class="space-y-3">
          {columnOne.map((item) => (
            <li class="group/item">
              <a href={item.url} class="text-xs text-[#F4EBD9]/70 hover:text-[#06B6D4] flex items-center group transition-all hover:translate-x-1 uppercase tracking-wider font-mono bg-[#09090b] p-2 border-2 border-[#1C1B1A] hover:border-[#06B6D4] hover:bg-[#06B6D4]/10 shadow-[2px_2px_0px_0px_#1C1B1A] hover:shadow-[4px_4px_0px_0px_#06B6D4] hover:translate-x-[2px] hover:translate-y-[2px]">
                <span class="text-[#06B6D4] mr-2">→</span>
                <span class="text-[#F4EBD9]/40 group-hover:text-[#06B6D4] mr-2 border-2 border-[#1C1B1A] group-hover:border-[#06B6D4] px-1 text-[8px] bg-[#1C1B1A] group-hover:bg-[#06B6D4] text-[#F4EBD9]/60 group-hover:text-[#121215]">{item.tag}</span>
                <span class="group-hover:underline decoration-[#06B6D4] underline-offset-4">{item.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- COLUMN 2: RESOURCES -->
      <div>
        <div class="flex items-center space-x-2 text-[10px] font-bold tracking-[0.2em] text-[#06B6D4] mb-4 uppercase border-b-2 border-[#1C1B1A] pb-2">
          <span class="text-[#06B6D4]">●</span>
          <span>SYS.DIR // RESOURCES</span>
        </div>
        <ul class="space-y-3">
          {columnTwo.map((item) => (
            <li>
              <a href={item.url} class="text-xs text-[#F4EBD9]/70 hover:text-[#FF7597] flex items-center group transition-all hover:translate-x-1 uppercase tracking-wider font-mono bg-[#09090b] p-2 border-2 border-[#1C1B1A] hover:border-[#FF7597] hover:bg-[#FF7597]/10 shadow-[2px_2px_0px_0px_#1C1B1A] hover:shadow-[4px_4px_0px_0px_#FF7597] hover:translate-x-[2px] hover:translate-y-[2px]">
                <span class="text-[#FF7597] mr-2">→</span>
                <span class="text-[#F4EBD9]/40 group-hover:text-[#FF7597] mr-2 border-2 border-[#1C1B1A] group-hover:border-[#FF7597] px-1 text-[8px] bg-[#1C1B1A] group-hover:bg-[#FF7597] text-[#F4EBD9]/60 group-hover:text-[#121215]">{item.tag}</span>
                <span class="group-hover:underline decoration-[#FF7597] underline-offset-4">{item.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- COLUMN 3: EXPLORE -->
      <div>
        <div class="flex items-center space-x-2 text-[10px] font-bold tracking-[0.2em] text-[#22C55E] mb-4 uppercase border-b-2 border-[#1C1B1A] pb-2">
          <span class="text-[#22C55E]">●</span>
          <span>SYS.DIR // EXPLORE</span>
        </div>
        <ul class="space-y-3">
          {columnThree.map((item) => (
            <li>
              <a href={item.url} class="text-xs text-[#F4EBD9]/70 hover:text-[#22C55E] flex items-center group transition-all hover:translate-x-1 uppercase tracking-wider font-mono bg-[#09090b] p-2 border-2 border-[#1C1B1A] hover:border-[#22C55E] hover:bg-[#22C55E]/10 shadow-[2px_2px_0px_0px_#1C1B1A] hover:shadow-[4px_4px_0px_0px_#22C55E] hover:translate-x-[2px] hover:translate-y-[2px]">
                <span class="text-[#22C55E] mr-2">→</span>
                <span class="text-[#F4EBD9]/40 group-hover:text-[#22C55E] mr-2 border-2 border-[#1C1B1A] group-hover:border-[#22C55E] px-1 text-[8px] bg-[#1C1B1A] group-hover:bg-[#22C55E] text-[#F4EBD9]/60 group-hover:text-[#121215]">{item.tag}</span>
                <span class="group-hover:underline decoration-[#22C55E] underline-offset-4">{item.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- COLUMN 4: TOOLS & GAMES -->
      <div>
        <div class="flex items-center space-x-2 text-[10px] font-bold tracking-[0.2em] text-[#FF7597] mb-4 uppercase border-b-2 border-[#1C1B1A] pb-2">
          <span class="text-[#FF7597]">●</span>
          <span>SYS.DIR // TOOLS</span>
        </div>
        <ul class="space-y-3">
          {columnFour.map((item) => (
            <li>
              <a href={item.url} class="text-xs text-[#F4EBD9]/70 hover:text-white flex items-center group transition-all hover:translate-x-1 uppercase tracking-wider font-mono bg-[#09090b] p-2 border-2 border-[#1C1B1A] hover:border-white hover:bg-white/10 shadow-[2px_2px_0px_0px_#1C1B1A] hover:shadow-[4px_4px_0px_0px_white] hover:translate-x-[2px] hover:translate-y-[2px]">
                <span class="text-white mr-2">→</span>
                <span class="text-[#F4EBD9]/40 group-hover:text-[#121215] mr-2 border-2 border-[#1C1B1A] group-hover:border-white px-1 text-[8px] bg-[#1C1B1A] group-hover:bg-white text-[#F4EBD9]/60">{item.tag}</span>
                <span class="group-hover:underline decoration-white underline-offset-4">{item.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- CONNECT BUTTONS ROW -->
    <div id="contact" class="pt-6 border-t-2 border-[#1C1B1A] relative z-10">
      <div class="text-[10px] font-bold tracking-[0.2em] text-[#22C55E] mb-4 uppercase flex items-center">
        <span class="w-2 h-2 rounded-full bg-[#22C55E] mr-2 animate-pulse"></span>
        SYS.NET // ESTABLISH CONNECTION
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
        {socialLinks.map((social) => (
          <a href={social.url} target="_blank" rel="noopener noreferrer" class="border-2 border-[#1C1B1A] bg-[#09090b] p-3 text-center text-[10px] text-[#F4EBD9] hover:text-[#09090b] hover:bg-[#06B6D4] hover:border-[#06B6D4] transition-all duration-200 flex items-center justify-center space-x-2 uppercase tracking-widest font-bold shadow-[3px_3px_0px_0px_#1C1B1A] hover:shadow-none hover:translate-x-[3px] hover:translate-y-[3px]">
            <span class="text-[#06B6D4] group-hover:text-[#09090b] text-[10px]">↗</span>
            <span>{social.label}</span>
          </a>
        ))}
      </div>
    </div>
  </footer>

  <!-- BOTTOM COPYRIGHT BAR -->
  <div class="flex flex-col sm:flex-row justify-between items-center text-[10px] text-[#1C1B1A]/70 px-4 py-4 border-t-2 border-[#1C1B1A] uppercase tracking-widest font-mono">
    <p>© 2026 VAISHNAVI GUPTA // ALL SYSTEMS NOMINAL</p>
    <p>BUILT WITH <span class="text-[#1C1B1A] font-black">ASTRO</span> + <span class="text-[#1C1B1A] font-black">TAILWIND</span></p>
  </div>

</Layout>