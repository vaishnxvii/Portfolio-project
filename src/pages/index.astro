---
import Layout from '../layouts/Layout.astro';

const columns = [
  {
    title: "PROJECTS",
    items: [
      { name: "Apps & Software", tag: "SYS" },
      { name: "Hardware Projects", tag: "HW" },
      { name: "AI Tools & GPTs", tag: "AI" },
      { name: "Python Scripts", tag: "CODE" },
    ],
  },
  {
    title: "RESOURCES",
    items: [
      { name: "Build Logs & Notes", tag: "LOG" },
      { name: "System Architecture", tag: "DOC" },
      { name: "Indigenous Literatures", tag: "M.A." },
      { name: "Contact System", tag: "NET" },
    ],
  },
  {
    title: "EXPLORE",
    items: [
      { name: "Home Terminal", tag: "ROOT" },
      { name: "Project Timeline", tag: "TIME" },
      { name: "Literary Drawings", tag: "ART" },
      { name: "Now Dashboard", tag: "CUR" },
    ],
  },
  {
    title: "TOOLS & GAMES",
    items: [
      { name: "Interactive Todo List", tag: "TOOL" },
      { name: "Memory Card Game", tag: "GAME" },
      { name: "Debate & AI Ethics", tag: "WIN" },
      { name: "Tech News Feed", tag: "RSS" },
    ],
  },
];

const socials = [
  { label: "GITHUB", url: "https://github.com/vaishnxvii" },
  { label: "LINKEDIN", url: "https://www.linkedin.com" },
  { label: "X / TWITTER", url: "#" },
  { label: "YOUTUBE", url: "#" },
  { label: "SUBSTACK", url: "#" },
];

const now = new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false });
---

<Layout title="VAISHNAVI GUPTA // PORTFOLIO">

  <!-- ============================================ -->
  <!-- TOP HUD NAVIGATION BAR                       -->
  <!-- ============================================ -->
  <nav class="flex items-center justify-between py-3 border-b-2 border-black mb-8">

    <!-- Left: Brand -->
    <div class="flex items-center gap-2 text-xs font-bold tracking-widest">
      <span class="w-2.5 h-2.5 bg-[#22C55E] border border-black inline-block"></span>
      <span>~/VGUPTA</span>
    </div>

    <!-- Center: Metadata -->
    <div class="hidden md:flex items-center gap-3 text-[10px] font-bold tracking-widest text-[#1A1A1A]/60 uppercase">
      <span>LOC: LUCKNOW, IN</span>
      <span class="text-[#FF6B8B]">&middot;</span>
      <span>STATUS: ONLINE</span>
      <span class="text-[#FF6B8B]">&middot;</span>
      <span>{now}</span>
    </div>

    <!-- Right: Social Icons + Divider -->
    <div class="flex items-center gap-3">
      <a href="https://github.com/vaishnxvii" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="hover:text-[#FF6B8B] transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0012 2z"/></svg>
      </a>
      <span class="w-px h-4 bg-black/20"></span>
      <a href="https://www.linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="hover:text-[#FF6B8B] transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <span class="w-px h-4 bg-black/20"></span>
      <button id="menu-toggle" class="md:hidden border-2 border-black p-0.5 hover:bg-black hover:text-[#F4EBD9] transition-colors" aria-label="Toggle menu">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </nav>

  <!-- ============================================ -->
  <!-- TERMINAL BADGE                               -->
  <!-- ============================================ -->
  <div class="flex justify-center mb-8">
    <div class="bg-[#1A1A1A] text-white rounded-full px-4 py-1 text-[11px] font-bold tracking-widest inline-flex items-center gap-1">
      <span class="text-white/60">~/DIGITAL-GARDEN $</span>
      <span class="text-[#22C55E]">WHOAMI</span>
    </div>
  </div>

  <!-- ============================================ -->
  <!-- HERO BANNER BOX                              -->
  <!-- ============================================ -->
  <div class="relative mb-10">

    <!-- Side tabs — left -->
    <div class="absolute -left-5 top-1/2 -translate-y-1/2 flex flex-col gap-1.5 z-10">
      <span class="w-2.5 h-2.5 bg-[#F4EBD9] border border-black block"></span>
      <span class="w-2.5 h-2.5 bg-[#F4EBD9] border border-black block"></span>
      <span class="w-2.5 h-2.5 bg-[#F4EBD9] border border-black block"></span>
      <span class="w-2.5 h-2.5 bg-[#F4EBD9] border border-black block"></span>
    </div>

    <!-- Side tabs — right -->
    <div class="absolute -right-5 top-1/2 -translate-y-1/2 flex flex-col gap-1.5 z-10">
      <span class="w-2.5 h-2.5 bg-[#F4EBD9] border border-black block"></span>
      <span class="w-2.5 h-2.5 bg-[#F4EBD9] border border-black block"></span>
      <span class="w-2.5 h-2.5 bg-[#F4EBD9] border border-black block"></span>
      <span class="w-2.5 h-2.5 bg-[#F4EBD9] border border-black block"></span>
    </div>

    <!-- The box itself -->
    <div class="bg-[#FF6B8B] border-2 border-black shadow-[4px_4px_0px_0px_#000] px-8 py-10 md:px-12 md:py-12 relative overflow-hidden">

      <!-- Subtle pixel grid texture -->
      <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, #000 1px, transparent 1px); background-size: 8px 8px;"></div>

      <h1 class="text-3xl md:text-5xl font-extrabold tracking-widest uppercase relative z-10 leading-tight">
        VAISHNAVI GUPTA
      </h1>

      <p class="text-[10px] md:text-xs font-bold tracking-[0.3em] uppercase mt-3 text-[#1A1A1A]/50 relative z-10">
        VAISH-2022 &middot; IN PURSUIT OF TRUTH
      </p>
    </div>
  </div>

  <!-- ============================================ -->
  <!-- PIXEL ART / IMAGE CONTAINER                  -->
  <!-- ============================================ -->
  <div class="mb-10">
    <div class="border-2 border-black shadow-[4px_4px_0px_0px_#000] bg-[#F4EBD9] p-3 inline-block">
      <div class="border border-black/20 w-full aspect-video max-w-md flex items-center justify-center bg-[#F4EBD9] overflow-hidden" style="image-rendering: pixelated;">
        <div class="text-[10px] font-bold tracking-widest text-[#1A1A1A]/30 uppercase">[ Portrait ]</div>
      </div>
    </div>
  </div>

  <!-- ============================================ -->
  <!-- ROLES & SUBTITLES                            -->
  <!-- ============================================ -->
  <div class="mb-10 space-y-3">
    <h2 class="text-lg md:text-xl font-extrabold tracking-widest uppercase">
      PYTHON DEVELOPER &amp; AUTHOR.
    </h2>
    <p class="text-[11px] font-bold tracking-widest uppercase text-[#1A1A1A]/60 leading-relaxed">
      M.A. LITERATURE &middot; INDIGENOUS EPISTEMOLOGIES &middot; AGENTIC SYSTEMS
    </p>
    <p class="text-xs font-bold tracking-wider uppercase pt-1">
      <a href="#" class="underline decoration-[#FF6B8B] decoration-dotted underline-offset-4 hover:text-[#FF6B8B] transition-colors">
        AFTER LIFE: REBORN OF LOVE
      </a>
      <span class="text-[#1A1A1A]/40 ml-2">(PUBLISHED 2022)</span>
    </p>
  </div>

  <!-- ============================================ -->
  <!-- SECTION DIVIDER                              -->
  <!-- ============================================ -->
  <div class="border-t-2 border-black mb-8"></div>

  <!-- ============================================ -->
  <!-- BENTO GRID FOOTER                            -->
  <!-- ============================================ -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-8 mb-10">
    {columns.map((col) => (
      <div>
        <div class="text-[10px] font-bold tracking-[0.2em] text-[#1A1A1A] mb-3 uppercase border-b-2 border-black pb-2">
          {col.title}
        </div>
        <ul class="space-y-1.5">
          {col.items.map((item) => (
            <li>
              <a
                href="#"
                class="text-[11px] font-bold tracking-wider uppercase flex items-center gap-2 hover:translate-x-1 transition-transform"
              >
                <span class="text-[#1A1A1A]/30">-</span>
                <span>{item.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <!-- ============================================ -->
  <!-- CONNECT ROW                                  -->
  <!-- ============================================ -->
  <div class="border-t-2 border-black pt-6 mb-8">
    <div class="text-[10px] font-bold tracking-[0.2em] text-[#1A1A1A]/50 mb-3 uppercase">
      CONNECT
    </div>
    <div class="flex flex-wrap gap-2">
      {socials.map((s) => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          class="border-2 border-black px-3 py-1.5 text-[10px] font-bold tracking-widest uppercase hover:bg-black hover:text-[#F4EBD9] transition-colors shadow-[2px_2px_0px_0px_#000] hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px]"
        >
          {s.label}
        </a>
      ))}
    </div>
  </div>

  <!-- ============================================ -->
  <!-- COPYRIGHT BAR                                -->
  <!-- ============================================ -->
  <div class="flex flex-col sm:flex-row justify-between items-center text-[10px] font-bold tracking-widest uppercase text-[#1A1A1A]/40 pt-4 border-t border-black/20">
    <p>&copy; 2026 VAISHNAVI GUPTA</p>
    <p>BUILT WITH ASTRO + TAILWIND</p>
  </div>

</Layout>
