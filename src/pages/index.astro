---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    id: "rainfall",
    name: "RAINFALL PREDICTION",
    description: "Machine learning model predicting rainfall with 87.02% accuracy using Python & Scikit-learn, evaluating XGBoost, SVM, and Logistic Regression algorithms via ROC-AUC scores.",
    tags: ["PYTHON", "SCIKIT-LEARN", "XGBOOST", "MACHINE LEARNING"],
    github: "https://github.com/vaishnxvii",
    demo: "#",
    metrics: [
      { value: "87.02%", label: "ACCURACY SCORE" },
      { value: "SCIKIT-LEARN", label: "CORE ENGINE" },
      { value: "CLASSIFICATION", label: "MODEL TYPE" },
    ],
  },
  {
    id: "salary",
    name: "SALARY PREDICTION",
    description: "End-to-end regression model predicting professional salaries based on years of experience, achieving 65.9% accuracy via data cleaning, feature engineering, and Polynomial Regression.",
    tags: ["PYTHON", "PANDAS", "NUMPY", "REGRESSION"],
    github: "https://github.com/vaishnxvii",
    demo: "#",
    metrics: [
      { value: "65.9%", label: "ACCURACY" },
      { value: "REGRESSION", label: "PIPELINE" },
      { value: "PREDICTIVE ML", label: "DOMAIN" },
    ],
  },
  {
    id: "bike",
    name: "BIKE HAVEN ANALYSIS",
    description: "Data analysis project uncovering actionable insights on sales performance and customer purchasing behavior using SQL for aggregation and Tableau for interactive visualization.",
    tags: ["TABLEAU", "SQL", "POSTGRESQL", "DATA ANALYSIS"],
    github: "https://github.com/vaishnxvii",
    demo: "#",
    metrics: [
      { value: "TABLEAU", label: "VISUALIZATION" },
      { value: "SQL", label: "AGGREGATION" },
      { value: "SALES INSIGHTS", label: "DOMAIN" },
    ],
  },
  {
    id: "ipl",
    name: "IPL AUCTION ANALYSIS",
    description: "Exploratory data analysis on cricket player performance and auction data using PostgreSQL to identify key player valuation factors and price correlations.",
    tags: ["POSTGRESQL", "SQL", "EDA", "SEABORN"],
    github: "https://github.com/vaishnxvii",
    demo: "#",
    metrics: [
      { value: "POSTGRESQL", label: "DATABASE" },
      { value: "EDA", label: "METHODOLOGY" },
      { value: "VALUATION", label: "INSIGHT" },
    ],
  },
  {
    id: "fitbit",
    name: "FITBIT FITNESS DASHBOARD",
    description: "End-to-end analysis of personal fitness tracking data in Excel, building automated formulas, pivot tables, and an interactive KPI executive dashboard.",
    tags: ["ADVANCED EXCEL", "PIVOT TABLES", "KPI DASHBOARD"],
    github: "https://github.com/vaishnxvii",
    demo: "#",
    metrics: [
      { value: "EXCEL", label: "PLATFORM" },
      { value: "PIVOT KPI", label: "STRUCTURE" },
      { value: "HEALTH DATA", label: "DOMAIN" },
    ],
  },
];

const socials = [
  { label: "GITHUB", url: "https://github.com/vaishnxvii" },
  { label: "LINKEDIN", url: "https://www.linkedin.com" },
  { label: "X / TWITTER", url: "#" },
  { label: "YOUTUBE", url: "#" },
  { label: "SUBSTACK", url: "#" },
];

const now = new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false });
---

<Layout title="VAISHNAVI GUPTA // PORTFOLIO">

  <!-- ============================================ -->
  <!-- TOP HUD NAVIGATION BAR                       -->
  <!-- ============================================ -->
  <nav class="flex items-center justify-between py-3 border-b-2 border-black mb-8">

    <!-- Left: Brand -->
    <div class="flex items-center gap-2 text-xs font-bold tracking-widest">
      <span class="w-2.5 h-2.5 bg-[#22C55E] border border-black inline-block"></span>
      <span>~/VGUPTA</span>
    </div>

    <!-- Center: Metadata -->
    <div class="hidden md:flex items-center gap-3 text-[10px] font-bold tracking-widest text-[#1A1A1A]/60 uppercase">
      <span>LOC: LUCKNOW, IN</span>
      <span class="text-[#FF6B8B]">&middot;</span>
      <span>STATUS: ONLINE</span>
      <span class="text-[#FF6B8B]">&middot;</span>
      <span>{now}</span>
    </div>

    <!-- Right: Social Icons + Divider -->
    <div class="flex items-center gap-3">
      <a href="https://github.com/vaishnxvii" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="hover:text-[#FF6B8B] transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0012 2z"/></svg>
      </a>
      <span class="w-px h-4 bg-black/20"></span>
      <a href="https://www.linkedin.com/in/vaishnavigupta55/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="hover:text-[#FF6B8B] transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <span class="w-px h-4 bg-black/20"></span>
      <a href="tel:+916386320950" aria-label="Phone" class="group relative flex items-center hover:text-[#FF6B8B] transition-colors">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        <span class="absolute top-full left-1/2 -translate-x-1/2 mt-2 whitespace-nowrap text-[10px] font-bold tracking-widest bg-[#1A1A1A] text-[#F4EBD9] px-2 py-1 border border-black shadow-[2px_2px_0px_0px_#000] opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-50">+916386320950</span>
      </a>
      <span class="w-px h-4 bg-black/20"></span>
      <button id="menu-toggle" class="md:hidden border-2 border-black p-0.5 hover:bg-black hover:text-[#F4EBD9] transition-colors" aria-label="Toggle menu">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </nav>

  <!-- ============================================ -->
  <!-- TERMINAL BADGE                               -->
  <!-- ============================================ -->
  <div class="flex justify-center mb-8">
    <div class="bg-[#1A1A1A] text-white rounded-full px-4 py-1 text-[11px] font-bold tracking-widest inline-flex items-center gap-1">
      <span class="text-white/60">~/DIGITAL-GARDEN $</span>
      <span class="text-[#22C55E]">WHOAMI</span>
    </div>
  </div>

  <!-- ============================================ -->
  <!-- HERO BANNER BOX                              -->
  <!-- ============================================ -->
  <div class="relative mb-10">

    <!-- Side tabs — left -->
    <div class="absolute -left-5 top-1/2 -translate-y-1/2 flex flex-col gap-1.5 z-10">
      <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
      <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
      <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
      <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
    </div>

    <!-- Side tabs — right -->
    <div class="absolute -right-5 top-1/2 -translate-y-1/2 flex flex-col gap-1.5 z-10">
      <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
      <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
      <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
      <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
    </div>

    <!-- The box itself -->
    <div class="bg-[#FF6B8B] border-2 border-black shadow-[4px_4px_0px_0px_#000] px-8 py-10 md:px-12 md:py-12 relative overflow-hidden">

      <!-- Subtle pixel grid texture -->
      <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, #000 1px, transparent 1px); background-size: 8px 8px;"></div>

      <h1 class="text-3xl md:text-5xl font-extrabold tracking-widest uppercase relative z-10 leading-tight">
        VAISHNAVI GUPTA
      </h1>

      <p class="text-[10px] md:text-xs font-bold tracking-[0.3em] uppercase mt-3 text-[#1A1A1A]/50 relative z-10">
        VAISH-2003 &middot; MORE TO GROW, MORE TO BE.
      </p>
    </div>
  </div>

  <!-- ============================================ -->
  <!-- PROFILE IMAGE                                -->
  <!-- ============================================ -->
  <div class="mb-10 flex justify-center">
    <div class="pixel-dither-frame w-72 h-56">
      <img src="/profile.png" alt="Vaishnavi Gupta" />
    </div>
  </div>

  <!-- ============================================ -->
  <!-- ROLES & SUBTITLES                            -->
  <!-- ============================================ -->
  <div class="mb-10 space-y-3">
    <h2 class="text-lg md:text-xl font-extrabold tracking-widest uppercase">
      AI ENGINEER &amp; PYTHON DEVELOPER
    </h2>
    <p class="text-[11px] font-bold tracking-widest uppercase text-[#1A1A1A]/60 leading-relaxed">
      AI/ML Developer &middot; RPA AUTOMATION &middot; Python & UiPath RPA Developer  
    </p>
  </div>

  <!-- ============================================ -->
  <!-- SECTION DIVIDER                              -->
  <!-- ============================================ -->
  <div class="border-t-2 border-black mb-8"></div>

  <!-- ============================================ -->
  <!-- TECH STACK SECTION                          -->
  <!-- ============================================ -->
  <section id="skills" class="mb-10">

    <!-- Terminal Command Pill -->
    <div class="flex justify-center mb-4">
      <div class="bg-[#1A1A1A] text-white rounded-full px-5 py-1 text-xs font-mono tracking-wider inline-flex items-center gap-1">
        <span class="text-white/60">~/DIGITAL-GARDEN $</span>
        <span class="text-[#22C55E]">LS ~/SKILLS --ALL</span>
      </div>
    </div>

    <!-- Pink Banner -->
    <div class="relative mb-6">
      <div class="absolute -left-5 top-1/2 -translate-y-1/2 flex flex-col gap-1.5 z-10">
        <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
        <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
        <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
        <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
      </div>
      <div class="absolute -right-5 top-1/2 -translate-y-1/2 flex flex-col gap-1.5 z-10">
        <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
        <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
        <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
        <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
      </div>
      <div class="bg-[#FF7597] border-2 border-black shadow-[4px_4px_0px_0px_#000] px-6 py-4 relative overflow-hidden">
        <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, #000 1px, transparent 1px); background-size: 8px 8px;"></div>
        <h2 class="text-xl md:text-2xl font-black tracking-widest uppercase relative z-10 text-center">
          TECHNICAL SKILLS
        </h2>
      </div>
    </div>

    <!-- Skills Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">

      <!-- Card 1: Programming & Backend -->
      <div class="border-2 border-black bg-[#F4EBD9] p-5 shadow-[4px_4px_0px_0px_#000]">
        <div class="text-[10px] font-mono tracking-wider text-[#1A1A1A]/50 mb-3 uppercase">
          $ CAT ./SKILLS/BACKEND.TXT
        </div>
        <h3 class="text-sm font-black tracking-widest uppercase mb-4">
          PROGRAMMING &amp; BACKEND
        </h3>
        <div class="flex flex-wrap gap-2">
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">Python</span>
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">FastAPI</span>
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">Django</span>
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">REST APIs</span>
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">SQL</span>
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">PostgreSQL</span>
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">SQLAlchemy</span>
        </div>
      </div>

      <!-- Card 2: AI & Machine Learning -->
      <div class="border-2 border-black bg-[#F4EBD9] p-5 shadow-[4px_4px_0px_0px_#000]">
        <div class="text-[10px] font-mono tracking-wider text-[#1A1A1A]/50 mb-3 uppercase">
          $ CAT ./SKILLS/AI_ML.TXT
        </div>
        <h3 class="text-sm font-black tracking-widest uppercase mb-4">
          AI &amp; MACHINE LEARNING
        </h3>
        <div class="flex flex-wrap gap-2">
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">Scikit-learn</span>
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">TensorFlow</span>
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">Hugging Face</span>
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">Groq API</span>
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">LLM Integration</span>
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">Prompt Engineering</span>
        </div>
      </div>

      <!-- Card 3: Intelligent Automation -->
      <div class="border-2 border-black bg-[#F4EBD9] p-5 shadow-[4px_4px_0px_0px_#000]">
        <div class="text-[10px] font-mono tracking-wider text-[#1A1A1A]/50 mb-3 uppercase">
          $ CAT ./SKILLS/AUTOMATION.TXT
        </div>
        <h3 class="text-sm font-black tracking-widest uppercase mb-4">
          INTELLIGENT AUTOMATION
        </h3>
        <div class="flex flex-wrap gap-2">
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">UiPath</span>
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">AI Agents</span>
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">Workflow Automation</span>
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">Robotic Process Automation (RPA)</span>
        </div>
      </div>

      <!-- Card 4: Tools & DevOps -->
      <div class="border-2 border-black bg-[#F4EBD9] p-5 shadow-[4px_4px_0px_0px_#000]">
        <div class="text-[10px] font-mono tracking-wider text-[#1A1A1A]/50 mb-3 uppercase">
          $ CAT ./SKILLS/DEVOPS.TXT
        </div>
        <h3 class="text-sm font-black tracking-widest uppercase mb-4">
          TOOLS &amp; DEVOPS
        </h3>
        <div class="flex flex-wrap gap-2">
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">Git/GitHub</span>
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">Docker</span>
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">Redis</span>
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">Render</span>
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">Linux</span>
          <span class="border border-black bg-white/60 px-2 py-1 text-xs font-bold font-mono">VS Code</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ============================================ -->
  <!-- TOP PROJECTS SHOWCASE                        -->
  <!-- ============================================ -->
  <section id="projects" class="mb-10">

    <!-- Terminal Command Pill -->
    <div class="flex justify-center mb-4">
      <div class="bg-[#1A1A1A] text-white rounded-full px-5 py-1 text-xs font-mono tracking-wider inline-flex items-center gap-1">
        <span class="text-white/60">~/DIGITAL-GARDEN $</span>
        <span class="text-[#22C55E]">LS ~/PROJECTS --TOP</span>
      </div>
    </div>

    <!-- Pink Banner -->
    <div class="relative mb-6">
      <div class="absolute -left-5 top-1/2 -translate-y-1/2 flex flex-col gap-1.5 z-10">
        <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
        <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
        <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
        <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
      </div>
      <div class="absolute -right-5 top-1/2 -translate-y-1/2 flex flex-col gap-1.5 z-10">
        <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
        <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
        <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
        <span class="w-2.5 h-2.5 bg-[#1A1A1A] block"></span>
      </div>
      <div class="bg-[#FF7597] border-2 border-black shadow-[4px_4px_0px_0px_#000] px-6 py-4 relative overflow-hidden">
        <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, #000 1px, transparent 1px); background-size: 8px 8px;"></div>
        <h2 class="text-xl md:text-2xl font-black tracking-widest uppercase relative z-10 text-center">
          TOP PROJECTS
        </h2>
      </div>
    </div>

    <!-- Tab Bar -->
    <div class="flex flex-wrap gap-2 mb-6">
      {projects.map((project, i) => (
        <button
          data-project-tab={project.id}
          class:list={[
            "project-tab px-3 py-1.5 text-[10px] font-bold tracking-widest uppercase border-2 border-black transition-all",
            i === 0
              ? "bg-[#FF7597] text-[#1A1A1A] shadow-[2px_2px_0px_0px_#000]"
              : "bg-[#EFEAD8] text-[#1A1A1A]/70 hover:bg-[#FF7597]/30"
          ]}
        >
          {project.name}
        </button>
      ))}
    </div>

    <!-- Active Project Card -->
    {projects.map((project, i) => (
      <div
        data-project-card={project.id}
        class:list={["project-card border-2 border-black bg-[#F4EBD9] p-6 shadow-[4px_4px_0px_0px_#000]", i !== 0 && "hidden"]}
      >
        <!-- Terminal Path -->
        <div class="text-[10px] font-mono tracking-wider text-[#1A1A1A]/50 mb-3 uppercase">
          $ CAT ./PROJECTS/{project.id.toUpperCase()}/README.MD
        </div>

        <!-- Title -->
        <h3 class="text-xl md:text-2xl font-black tracking-widest uppercase text-[#FF7597] mb-4">
          {project.name}
        </h3>

        <!-- Description -->
        <p class="text-xs font-bold tracking-wide text-[#1A1A1A]/70 leading-relaxed mb-5 max-w-2xl">
          {project.description}
        </p>

        <!-- Tech Tags -->
        <div class="flex flex-wrap gap-2 mb-6">
          {project.tags.map((tag) => (
            <span class="border-2 border-black px-2 py-0.5 text-[9px] font-bold tracking-widest uppercase bg-[#1A1A1A] text-[#F4EBD9]">
              {tag}
            </span>
          ))}
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap gap-3">
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="border-2 border-black px-4 py-2 text-[10px] font-bold tracking-widest uppercase bg-[#1A1A1A] text-[#F4EBD9] hover:bg-[#FF7597] hover:text-[#1A1A1A] transition-colors shadow-[2px_2px_0px_0px_#000] hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px]"
          >
            VIEW CODE / GITHUB &rarr;
          </a>
          <a
            href={project.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="border-2 border-black px-4 py-2 text-[10px] font-bold tracking-widest uppercase bg-[#F4EBD9] text-[#1A1A1A] hover:bg-[#FF7597] hover:text-[#1A1A1A] transition-colors shadow-[2px_2px_0px_0px_#000] hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px]"
          >
            LIVE DEMO / REPORT &rarr;
          </a>
        </div>
      </div>
    ))}

    <!-- Metric Cards (updates with active tab) -->
    {projects.map((project, i) => (
      <div
        data-project-metrics={project.id}
        class:list={["project-metrics grid grid-cols-1 md:grid-cols-3 gap-4 mt-6", i !== 0 && "hidden"]}
      >
        {project.metrics.map((metric) => (
          <div class="border-2 border-black bg-[#F4EBD9] p-4 shadow-[3px_3px_0px_0px_#000] text-center">
            <div class="text-lg md:text-xl font-black tracking-widest uppercase text-[#FF7597]">
              {metric.value}
            </div>
            <div class="text-[9px] font-bold tracking-[0.2em] uppercase text-[#1A1A1A]/50 mt-1">
              {metric.label}
            </div>
          </div>
        ))}
      </div>
    ))}
  </section>

  <!-- ============================================ -->
  <!-- CONNECT ROW                                  -->
  <!-- ============================================ -->
  <div class="border-t-2 border-black pt-6 mb-8">
    <div class="text-[10px] font-bold tracking-[0.2em] text-[#1A1A1A]/50 mb-3 uppercase">
      CONNECT
    </div>
    <div class="flex flex-wrap gap-2">
      {socials.map((s) => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          class="border-2 border-black px-3 py-1.5 text-[10px] font-bold tracking-widest uppercase hover:bg-black hover:text-[#F4EBD9] transition-colors shadow-[2px_2px_0px_0px_#000] hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px]"
        >
          {s.label}
        </a>
      ))}
    </div>
  </div>

  <!-- ============================================ -->
  <!-- COPYRIGHT BAR                                -->
  <!-- ============================================ -->
  <div class="flex flex-col sm:flex-row justify-between items-center text-[10px] font-bold tracking-widest uppercase text-[#1A1A1A]/40 pt-4 border-t border-black/20">
    <p>&copy; 2026 VAISHNAVI GUPTA</p>
    <p>BUILT WITH ASTRO + TAILWIND</p>
  </div>

</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('[data-project-tab]');
    const cards = document.querySelectorAll('[data-project-card]');
    const metrics = document.querySelectorAll('[data-project-metrics]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const id = tab.getAttribute('data-project-tab');

        // Update tab styles
        tabs.forEach((t) => {
          t.className = t.className
            .replace('bg-[#FF7597]', 'bg-[#EFEAD8]')
            .replace('shadow-[2px_2px_0px_0px_#000]', '')
            .replace('text-[#1A1A1A]', 'text-[#1A1A1A]/70');
        });
        tab.className = tab.className
          .replace('bg-[#EFEAD8]', 'bg-[#FF7597]')
          .replace('text-[#1A1A1A]/70', 'text-[#1A1A1A]');
        if (!tab.className.includes('shadow-[2px_2px_0px_0px_#000]')) {
          tab.classList.add('shadow-[2px_2px_0px_0px_#000]');
        }

        // Show matching card and metrics, hide others
        cards.forEach((c) => {
          c.classList.toggle('hidden', c.getAttribute('data-project-card') !== id);
        });
        metrics.forEach((m) => {
          m.classList.toggle('hidden', m.getAttribute('data-project-metrics') !== id);
        });
      });
    });
  });
</script>
