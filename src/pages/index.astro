<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('[data-project-tab]');
    const cards = document.querySelectorAll('[data-project-card]');
    const metrics = document.querySelectorAll('[data-project-metrics]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const id = tab.getAttribute('data-project-tab');

        // Update tab styles
        tabs.forEach((t) => {
          t.className = t.className
            .replace('bg-[#FF7597]', 'bg-[#EFEAD8]')
            .replace('shadow-[2px_2px_0px_0px_#000]', '')
            .replace('text-[#1A1A1A]', 'text-[#1A1A1A]/70');
        });
        tab.className = tab.className
          .replace('bg-[#EFEAD8]', 'bg-[#FF7597]')
          .replace('text-[#1A1A1A]/70', 'text-[#1A1A1A]');
        if (!tab.className.includes('shadow-[2px_2px_0px_0px_#000]')) {
          tab.classList.add('shadow-[2px_2px_0px_0px_#000]');
        }

        // Show matching card and metrics, hide others
        cards.forEach((c) => {
          c.classList.toggle('hidden', c.getAttribute('data-project-card') !== id);
        });
        metrics.forEach((m) => {
          m.classList.toggle('hidden', m.getAttribute('data-project-metrics') !== id);
        });
      });
    });

    // Certificate file-system drill-down
    const certFolders = document.querySelectorAll('.cert-folder');
    const certRootView = document.getElementById('cert-root-view');
    const certDetailView = document.getElementById('cert-detail-view');
    const certBackBtn = document.getElementById('cert-back-btn');
    const certTerminalCmd = document.getElementById('cert-terminal-cmd');
    const certFooter = document.getElementById('cert-footer');
    const certDetailPath = document.getElementById('cert-detail-path');
    const certDetailTitle = document.getElementById('cert-detail-title');
    const certDetailLink = document.getElementById('cert-detail-link');
    const certDetailIssuer = document.getElementById('cert-detail-issuer');
    const certDetailYear = document.getElementById('cert-detail-year');

    const certData = [
      {
        folder: "UIPATH",
        label: "UiPATH AUTOMATION",
        title: "UIPATH ACADEMY AUTOMATION DEVELOPER ASSOCIATE TRAINING - UIPATH (2026)",
        link: "https://credentials.uipath.com/3d880dbc-1ff0-4a4a-b44a-0422276e60db",
        issuer: "UiPath",
        year: "2026",
      },
      {
        folder: "DATASCIENCE",
        label: "DATA SCIENCE",
        title: "DATA SCIENCE PLACEMENT COURSE - INTERNSHALA (2024)",
        link: "https://trainings.internshala.com/view_certificate/i0zop8pgwt1/963b7w46fcw/",
        issuer: "Internshala",
        year: "2024",
      },
      {
        folder: "DATAANALYSIS",
        label: "DATA ANALYSIS",
        title: "DATA ANALYSIS USING PYTHON - IBM (2024)",
        link: "https://www.credly.com/badges/19d7b664-cb0f-4f76-8104-08f1fcecdbe3/linked_in_profile",
        issuer: "IBM",
        year: "2024",
      },
      {
        folder: "SAMSUNG_PYTHON",
        label: "SAMSUNG PYTHON",
        title: "PROGRAMMING WITH PYTHON - SAMSUNG INNOVATION CAMPUS (2024)",
        link: "https://drive.google.com/file/d/1SUW3vZjIBwTcW1E7TadaKcywA02cxb2k/view?usp=drivesdk",
        issuer: "Samsung Innovation Campus",
        year: "2024",
      },
      {
        folder: "SAMSUNG_AI",
        label: "SAMSUNG AI",
        title: "ARTIFICIAL INTELLIGENCE - SAMSUNG INNOVATION CAMPUS (2023)",
        link: "https://drive.google.com/file/d/13pdxk5Gu8C6gvSyoRV0V3PDh-_8QFpjC/view?usp=drivesdk",
        issuer: "Samsung Innovation Campus",
        year: "2023",
      },
    ];

    function showCertRoot() {
      certRootView.classList.remove('hidden');
      certDetailView.classList.add('hidden');
      certBackBtn.classList.add('hidden');
      certTerminalCmd.textContent = 'LS ~/CERTIFICATES';
      certFooter.textContent = 'FOLDERS: 5 | FILES: 0 | DEPTH: 0';
    }

    function showCertDetail(index) {
      const data = certData[index];
      certRootView.classList.add('hidden');
      certDetailView.classList.remove('hidden');
      certBackBtn.classList.remove('hidden');
      certTerminalCmd.textContent = 'LS ~/CERTIFICATES/' + data.folder;
      certFooter.textContent = 'FOLDERS: 0 | FILES: 1 | DEPTH: 1';
      certDetailPath.textContent = '$ CAT ./CERTIFICATES/' + data.folder + '/README.TXT';
      certDetailTitle.textContent = data.title;
      certDetailLink.href = data.link;
      certDetailIssuer.textContent = data.issuer;
      certDetailYear.textContent = data.year;
    }

    certFolders.forEach((folder) => {
      folder.addEventListener('click', () => {
        const idx = parseInt(folder.getAttribute('data-cert-index'));
        showCertDetail(idx);
      });
    });

    certBackBtn.addEventListener('click', showCertRoot);
  });
</script>
